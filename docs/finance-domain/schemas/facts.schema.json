{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
        "id": {
            "description": "事实键，如 ni_attr",
            "type": "string"
        },
        "name": {
            "description": "报表行项目名，如 归属于本行股东的净利润",
            "type": "string"
        },
        "period": {
            "description": "如 2024年末 / 2024年度",
            "type": "string"
        },
        "source": {
            "description": "出处：章节或附注编号 + 页码",
            "type": "string"
        },
        "unit": {
            "enum": [
                "百万元",
                "亿元",
                "元",
                "%"
            ],
            "type": "string"
        },
        "value": {
            "description": "数值本身；文本描述里的数不算落盘",
            "type": "number"
        }
    },
    "required": [
        "id",
        "name",
        "value",
        "unit",
        "period",
        "source"
    ],
    "title": "Fact",
    "type": "object"
}