{
  "name": "shipkeel",
  "version": "0.1.0",
  "private": true,
  "description": "ShipKeel — 做任何 Agent 之前先定下的龙骨：五级范式决策树、语言无关的通用契约与按范式分的起步脚手架",
  "type": "module",
  "workspaces": [
    "scaffolds/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "smoke": "npm run smoke --workspaces --if-present",
    "start": "npm --workspace=@shipkeel/plan-execute start --",
    "list-domains": "npm --workspace=@shipkeel/plan-execute run list-domains",
    "demo": "npm --workspace=@shipkeel/plan-execute run demo --",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke && npm run list-domains"
  },
  "keywords": [
    "agent",
    "playbook",
    "scaffold",
    "harness",
    "mcp",
    "llm",
    "shipkeel"
  ],
  "author": "XingMXTeam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XingMXTeam/ShipKeel.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
