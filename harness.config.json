{
  "version": 1,
  "host": "generic",
  "stack": "node",
  "gateCommands": [
    "npm run typecheck",
    "npm test",
    "npm run build",
    "npm run smoke",
    "npm run list-domains"
  ],
  "budgets": {
    "maxMacroCycles": 5,
    "maxTaskRetries": 3
  },
  "autoStop": {
    "requiredStablePasses": 2
  },
  "evaluation": {
    "passScore": 0.9,
    "commandTimeoutMs": 120000
  },
  "git": {
    "requireCommitPerTask": true
  },
  "evidence": {
    "requireVerify": true
  }
}
