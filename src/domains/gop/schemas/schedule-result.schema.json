{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "schedule-result",
  "type": "object",
  "required": ["results"],
  "additionalProperties": true,
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["floorName", "success"],
        "additionalProperties": true,
        "properties": {
          "floorName": { "type": "string" },
          "scheduleId": { "type": "string" },
          "success": { "type": "boolean" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
