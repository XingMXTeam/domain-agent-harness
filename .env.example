# ─────────────────────────────────────────────────────────────
# domain-agent-harness 环境变量示例
# 复制为 .env 后按需填写；所有密钥一律走环境变量，不写进源码。
# ─────────────────────────────────────────────────────────────

# ── LLM Provider 选择 ──────────────────────────────────────
# anthropic | openai | dashscope
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI 兼容端点（也可指向 vLLM / Ollama / 各类网关）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DashScope（通义千问）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 通用调参
LLM_TIMEOUT_MS=600000
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0

# ── MCP 服务（按域在 src/domains/<domain>/mcp.json 中声明）──
# mcp.json 中的 {{XXX}} 占位符会被同名环境变量替换
GCP_MCP_TOKEN=
LOCALE_MCP_TOKEN=
GOP_MCP_TOKEN=
KM_MCP_TOKEN=

# ── 运行时行为 ─────────────────────────────────────────────
# 运行时产物根目录（默认 ./.runs）
DAH_RUNS_ROOT=
# 强制指定域，跳过 Catalog 路由（等价于 --domain=）
DAH_DOMAIN=
# 沙箱模式下由外部注入的用户输入
USER_INPUT=
